ENV=local
LOG_LEVEL=INFO
LOG_JSON=false

API_HOST=0.0.0.0
API_PORT=8080
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=120

DATABASE_URL=postgresql+psycopg://stock:stock@postgres:5432/stock_agent
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=stock-agent-data
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

DATA_CONNECTOR=demo
AKSHARE_RATE_LIMIT_PER_MINUTE=30
MARKET=CN_A

SCHEDULER_TIMEZONE=Asia/Shanghai
SCHEDULER_RUN_CRON=0 16 * * 1-5

JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720
ADMIN_API_KEY=dev-admin-key

STRATEGY_VERSION=mvp-1.0.0
COVERAGE_HARD_THRESHOLD=95.0
MAX_FOCUS_CANDIDATES=5
MAX_TOTAL_CANDIDATES=10
MAX_PER_INDUSTRY=2

PROMETHEUS_ENABLED=true
